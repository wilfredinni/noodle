{
  "name": "noodle",
  "version": "0.9.1",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "bin": {
    "noodle": "src/app/cli.ts"
  },
  "scripts": {
    "dev": "bun --watch src/app/cli.ts",
    "test": "bun test",
    "build:bin": "bun build --compile src/app/cli.ts --outfile noodle && bun scripts/sign-macos-binary.ts ./noodle && bun scripts/compiled-script-smoke.ts",
    "release:context": "bun scripts/release-context.ts",
    "release:check": "bun scripts/release-check.ts",
    "prepare": "husky",
    "audit": "bun audit",
    "lint": "oxlint .",
    "format": "oxfmt ./src ./tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@opentui/core": "^0.5.11",
    "@opentui/keymap": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "aws4": "^1.13.2",
    "citty": "^0.2.2",
    "httpsnippet": "^3.0.10",
    "jose": "^6.2.12",
    "js-yaml": "^5.4.2",
    "jsonc-parser": "^3.3.1",
    "jsonpath-plus": "^10.4.0",
    "oauth-1.0a": "^2.2.6",
    "postman-collection": "^5.3.1",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19.3.0",
    "sax": "1.6.1",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@types/aws4": "^1.11.6",
    "@types/react": "^19.3.0",
    "@types/sax": "1.2.7",
    "bun-types": "^1.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@faker-js/faker": "10.5.0",
    "form-data": "^4.0.6",
    "lodash": "^4.17.24",
    "uuid": "^11.1.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "tests/**/*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "patchedDependencies": {
    "httpsnippet@3.0.10": "patches/httpsnippet@3.0.10.patch",
    "postman-collection@5.3.1": "patches/postman-collection@5.3.1.patch"
  }
}
