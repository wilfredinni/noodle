{
  "name": "noodle",
  "version": "0.8.1",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "bin": {
    "noodle": "src/app/cli.ts"
  },
  "scripts": {
    "dev": "bun --watch src/app/cli.ts",
    "test": "bun test",
    "build:bin": "bun build --compile src/app/cli.ts --outfile noodle",
    "release:context": "bun scripts/release-context.ts",
    "release:check": "bun scripts/release-check.ts",
    "prepare": "husky",
    "audit": "bun audit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.5.8",
    "@opentui/keymap": "^0.5.8",
    "@opentui/react": "^0.5.8",
    "aws4": "^1.13.2",
    "citty": "^0.2.2",
    "httpsnippet": "^3.0.10",
    "jose": "^6.2.10",
    "js-yaml": "^4.3.2",
    "jsonc-parser": "^3.3.1",
    "jsonpath-plus": "^10.4.0",
    "oauth-1.0a": "^2.2.6",
    "postman-collection": "^5.3.1",
    "react": "^19.2.8",
    "tough-cookie": "^5.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws4": "^1.11.6",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.18",
    "bun-types": "^1.4.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "lodash": "^4.17.24",
    "uuid": "^11.1.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
