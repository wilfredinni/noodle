     JS_SetRuntimeOpaque(rt, data);
   }
   return data;
@@ -141,6 +149,66 @@ qts_RuntimeData *qts_get_context_rt_data(JSContext *ctx) {
   return qts_get_runtime_data(JS_GetRuntime(ctx));
 }
 
+static void qts_free_rejection(qts_Rejection *entry) {
+  JS_FreeValue(entry->ctx, entry->promise);
+  JS_FreeValue(entry->ctx, entry->reason);
+  js_free(entry->ctx, entry);
+}
+
+static void qts_clear_rejections(JSContext *ctx) {
+  qts_RuntimeData *data = qts_get_context_rt_data(ctx);
+  qts_Rejection **cursor = &data->rejections;
+  while (*cursor) {
+    qts_Rejection *entry = *cursor;
+    if (entry->ctx == ctx) {
+      *cursor = entry->next;
+      qts_free_rejection(entry);
+    } else {
+      cursor = &entry->next;
+    }
+  }
+}
+
+static void qts_track_rejection(JSContext *ctx, JSValueConst promise,
+                                JSValueConst reason, BOOL handled, void *opaque) {
+  qts_RuntimeData *data = qts_get_context_rt_data(ctx);
+  qts_Rejection **cursor = &data->rejections;
+  while (*cursor) {
+    qts_Rejection *entry = *cursor;
+    if (JS_VALUE_GET_PTR(entry->promise) == JS_VALUE_GET_PTR(promise)) {
+      if (handled) {
+        *cursor = entry->next;
+        qts_free_rejection(entry);
+      }
+      return;
+    }
+    cursor = &entry->next;
+  }
+  if (handled) return;
+  qts_Rejection *entry = js_malloc(ctx, sizeof(*entry));
+  if (!entry) {
+    data->rejection_oom = true;
+    return;
+  }
+  entry->ctx = ctx;
+  entry->promise = JS_DupValue(ctx, promise);
+  entry->reason = JS_DupValue(ctx, reason);
+  entry->next = NULL;
+  *cursor = entry;
+}
+
+static JSValue qts_check_rejections(JSContext *ctx, JSValueConst this_val,
+                                    int argc, JSValueConst *argv) {
+  qts_RuntimeData *data = qts_get_context_rt_data(ctx);
+  if (data->rejection_oom) return JS_ThrowOutOfMemory(ctx);
+  if (!data->rejections) return JS_UNDEFINED;
+  qts_Rejection *entry = data->rejections;
+  data->rejections = entry->next;
+  JSValue reason = JS_DupValue(ctx, entry->reason);
+  qts_free_rejection(entry);
+  return JS_Throw(ctx, reason);
+}
