+typedef struct qts_Rejection {
+  JSContext *ctx;
+  JSValue promise;
+  JSValue reason;
+  struct qts_Rejection *next;
+} qts_Rejection;
+
 typedef struct qts_RuntimeData {
   bool debug_log;
+  bool rejection_oom;
+  qts_Rejection *rejections;
 } qts_RuntimeData;
 
 qts_RuntimeData *qts_get_runtime_data(JSRuntime *rt) {
   qts_RuntimeData *data = JS_GetRuntimeOpaque(rt);
   if (data == NULL) {
-    data = malloc(sizeof(qts_RuntimeData));
